#pragma once

// Copy this file to secrets.h (which is gitignored — never commit it) and
// fill in your real Whoop's MAC address, found via find_whoop_mac/.
//
// Convention on Noah's machine: the real file lives OUTSIDE every checkout, at
// ~/.config/biohacker_bro/secrets.h, and each worktree gets a symlink to it —
// so the MAC survives worktree cleanup and one edit updates every checkout.
// The SessionStart hook in .claude/settings.json creates that symlink
// automatically in any new worktree. To set it up by hand elsewhere:
//
//   ln -sfn ~/.config/biohacker_bro/secrets.h "$(git rev-parse --show-toplevel)/secrets.h"
//
// Uppercase, colon-separated, e.g. "AA:BB:CC:DD:EE:FF".
#define TARGET_WHOOP_MAC "AA:BB:CC:DD:EE:FF"
